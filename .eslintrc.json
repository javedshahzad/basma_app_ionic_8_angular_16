{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["tsconfig.json"],
        "createDefaultProgram": true
      },
      "extends": [
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "plugins": ["@typescript-eslint"],
      "rules": {
        "@angular-eslint/component-class-suffix": [
          "error",
          {
            "suffixes": ["Page", "Component"]
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "@typescript-eslint/no-explicit-any": "warn",
        // New in @angular-eslint v20's recommended preset, defaulting to
        // "error". This codebase uses constructor-parameter DI everywhere
        // (~1100 sites) — a real, working, already-tested pattern, not a
        // bug. Migrating to inject() is a legitimate future improvement
        // (`ng generate @angular/core:inject` can do it automatically) but
        // is its own separate piece of work, out of scope for an Angular
        // version bump. Downgraded to warn so it stays visible without
        // blocking CI.
        "@angular-eslint/prefer-inject": "warn"
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {}
    }
  ]
}
