{
	"appId": "com.webapp.attendance",
	"appName": "بصمة",
	"bundledWebRuntime": false,
	"webDir": "www",
	"plugins": {
	  "SplashScreen": {
		"showSpinner": false,
		"launchShowDuration":3000,
		"launchAutoHide": true,
		"spinnerColor": "#f53d3d",
		"splashFullScreen": true
	  },
	  "PushNotifications": {
		"presentationOptions": ["badge", "sound", "alert"]
	  },
	  "CapacitorSQLite": {
		"iosIsEncryption": true,
		"iosKeychainPrefix": "com.webapp.attendance",
		"iosBiometric": {
		  "biometricAuth": false
		},
		"androidIsEncryption": true,
		"androidBiometric": {
		  "biometricAuth": false
		}
	  }
	},
	"cordova": {
		"prefrences":{
			"WKWebViewOnly":true
		}
	}
  }